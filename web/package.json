{
  "name": "virtual-tour-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-fiber-timer.mjs && node scripts/copy-asset-decoders.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:splat-proof": "node tests/splat-proof.browser.mjs",
    "test:hotspots": "node tests/hotspots.browser.mjs",
    "demo:hotspots": "node scripts/create-hotspot-demo.mjs",
    "test:appearance": "node tests/appearance.browser.mjs",
    "demo:appearance": "node scripts/create-appearance-demo.mjs",
    "demo:layout": "node scripts/create-layout-demo.mjs",
    "test:layout": "node tests/layout.browser.mjs",
    "test:materials": "node tests/materials.browser.mjs",
    "demo:materials": "node scripts/create-materials-demo.mjs",
    "test:walking": "node tests/walking.browser.mjs",
    "demo:walking": "node scripts/create-walking-demo.mjs",
    "test:editor": "node tests/editor.browser.mjs",
    "test:themes": "node tests/themes.browser.mjs",
    "test:usability": "node tests/usability.browser.mjs",
    "test:walking-map": "node tests/walking-map.browser.mjs",
    "test:client-viewer": "node tests/client-viewer.browser.mjs",
    "test:assembly": "node tests/assembly.browser.mjs",
    "test:numeric-inputs": "node tests/numeric-inputs.browser.mjs",
    "test:fan": "node tests/fan-animation.browser.mjs",
    "test:walking-effects": "node tests/walking-effects.browser.mjs",
    "test:stairs": "node tests/stairs-room.browser.mjs",
    "demo:performance": "node scripts/create-performance-demo.mjs",
    "test:performance": "node tests/performance.browser.mjs",
    "test:quality": "node tests/quality.browser.mjs",
    "test:runtime-textures": "node tests/runtime-textures.browser.mjs",
    "test:runtime-assets": "node tests/runtime-assets.browser.mjs",
    "benchmark:hotspots": "node scripts/benchmark-hotspot-visibility.mjs",
    "test:spatial-rendering": "node tests/spatial-rendering.browser.mjs",
    "test:room-streaming": "node tests/room-streaming.browser.mjs",
    "test:hq-rendering": "node tests/hq-rendering.browser.mjs",
    "test:chunking-baseline": "node tests/chunking-baseline.browser.mjs",
    "demo:chunking": "node scripts/create-performance-demo.mjs --chunking",
    "test:partition": "node tests/partition.browser.mjs",
    "test:chunk-streaming": "node tests/chunkStreaming.browser.mjs",
    "test:chunk-spatial": "CHUNK_SPATIAL=1 node tests/chunkStreaming.browser.mjs",
    "test:chunk-comparison": "node tests/chunking-comparison.browser.mjs",
    "test:chunk-live": "node tests/chunking-live.browser.mjs",
    "test:chunk-acceptance": "node ../scripts/validate-chunking.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "meshoptimizer": "^0.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.2",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
