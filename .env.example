# Docker Compose reads .env automatically. Copy .env.example to .env to customize.
BIND_ADDRESS=0.0.0.0
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8080
WEB_PORT=5173
POSTGRES_DB=virtual_tours
POSTGRES_USER=tour
POSTGRES_PASSWORD=tour-local-only
S3_ACCESS_KEY=tour-local
S3_SECRET_KEY=tour-local-secret
S3_BUCKET=virtual-tours
S3_REGION=us-east-1
# For access from another device, use this host's IP or hostname in both URLs.
S3_PUBLIC_ENDPOINT=http://localhost:9000
WEB_ORIGIN=http://localhost:5173

# For running the API outside Docker:
# DATABASE_URL=postgres://tour:tour-local-only@localhost:5432/virtual_tours?sslmode=disable
# HTTP_ADDR=0.0.0.0:8080
# S3_ENDPOINT=http://localhost:9000

# For bundled PostgreSQL + AWS S3 + HTTPS, use .env.production.example and
# ./deploy.sh --production up. The default compose.yml uses MinIO.
# Production storage: use AWS S3 and deployment-provided
# credentials or an IAM role. Configure bucket CORS using docs/s3-cors.json.
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_PUBLIC_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_SESSION_TOKEN=optional-token-for-temporary-credentials
# In production, a blank S3_ACCESS_KEY uses AWS environment credentials or an IAM role.
# WEB_ORIGIN=https://tour.example.com

# Native development only; Docker includes this processor at /app/asset-tools/process.mjs.
# Install with npm --prefix asset-tools ci, then set an absolute path to enable processing.
ASSET_PROCESSOR_SCRIPT=

# Rollout: off (default), reviewed static groups, or spatial (experimental cells).
ASSET_CHUNK_STREAMING=off

# Gaussian capture rollout: off, viewer (existing captures), on (new authoring).
# Both gates must permit support; frontend changes require an image rebuild.
ASSET_SPLAT_SUPPORT=off
VITE_SPLAT_SUPPORT=off
