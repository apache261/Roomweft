# Copy to .env, configure values, then run ./deploy.sh --production up.
# Production bundles PostgreSQL just like development; no separate database needed.
HTTP_ADDR=0.0.0.0:8080
POSTGRES_DB=virtual_tours
POSTGRES_USER=tour
# Use a strong URL-safe password (letters/numbers/-/_). Match existing credentials
# when reusing a database volume; changing this value does not reset that database.
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
# Compose builds DATABASE_URL for postgres:5432 on the internal Docker network.
# PostgreSQL/API/frontend ports are not published; HTTP/HTTPS enter through Nginx.
HTTPS_PORT=443

# Existing private AWS S3 bucket. Match the endpoint and region to your bucket.
S3_BUCKET=replace-with-production-bucket
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_PUBLIC_ENDPOINT=https://s3.us-east-1.amazonaws.com

# Leave blank to use AWS environment credentials or an IAM role.
# For explicit credentials, fill in both values; use a session token if temporary.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SESSION_TOKEN=

# Exact frontend origin to configure in the bucket CORS policy (docs/s3-cors.json).
# The API does not apply the bucket CORS policy automatically.
WEB_ORIGIN=https://tour.example.com

# Certbot containers: ./certbot.sh --production issue, test, start (see README.md).
# Use a hostname, without https://. No host Certbot installation is required.
# These deployment values are not read by the API; HTTPS terminates at your proxy.
CERTBOT_DOMAIN=tour.example.com
CERTBOT_EMAIL=admin@example.com
# Persistent host storage. Back up the entire directory, including account data.
CERTBOT_DATA_DIR=./data/certbot
CERTBOT_IMAGE=certbot/certbot:v5.8.0
CERTBOT_BIND_ADDRESS=0.0.0.0
# Let's Encrypt must reach public port 80. Change only when forwarding to this port.
CERTBOT_HTTP_PORT=80
CERTBOT_RENEW_INTERVAL_SECONDS=43200
# Paths inside the bundled Nginx proxy. Match the directory to CERTBOT_DOMAIN.
# The proxy watches for issued/renewed certificates and automatically reloads.
TLS_CERT_FILE=/etc/letsencrypt/live/tour.example.com/fullchain.pem
TLS_KEY_FILE=/etc/letsencrypt/live/tour.example.com/privkey.pem

# Set for native deployments; the Docker image includes this by default.
# ASSET_PROCESSOR_SCRIPT=/app/asset-tools/process.mjs

# Rollout: off (default), reviewed static groups, or spatial (experimental cells).
ASSET_CHUNK_STREAMING=off
