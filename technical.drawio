        <mxCell id="1-14" value="&lt;b&gt;Node.js asset processor&lt;/b&gt;&lt;br&gt;&lt;br&gt;glTF Transform • Meshoptimizer&lt;br&gt;Sharp • glTF Validator • Three.js&lt;br&gt;Verified GLB/PNG tiers + collision.glb&lt;br&gt;SHA-256 identity and integrity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
