        </mxCell>
        <mxCell id="5-14" value="&lt;b&gt;Interactive rendered view&lt;/b&gt;&lt;br&gt;&lt;br&gt;Walking / orbit / panorama • hotspots / reticle&lt;br&gt;Information popups pause movement&lt;br&gt;Explicit exits validate destination before switching" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
