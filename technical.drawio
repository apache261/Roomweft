        <mxCell id="2-11" value="&lt;b&gt;1  Select GLB or image&lt;/b&gt;&lt;br&gt;&lt;br&gt;GLB ≤1000 MiB • images ≤100 MiB&lt;br&gt;Header / decoding / dimension checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="220" width="350" height="100" />
        </mxCell>
        <mxCell id="2-12" value="&lt;b&gt;2  Request upload ticket&lt;/b&gt;&lt;br&gt;&lt;br&gt;POST /projects/{id}/uploads&lt;br&gt;Filename • role • size • project checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="505" y="350" width="350" height="110" />
        </mxCell>
        <mxCell id="2-13" value="&lt;b&gt;3  Sign POST policy&lt;/b&gt;&lt;br&gt;&lt;br&gt;pending/{storage_key}&lt;br&gt;Exact size + content type + key&lt;br&gt;Expires in 15 minutes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="945" y="350" width="350" height="110" />
        </mxCell>
        <mxCell id="2-14" value="&lt;b&gt;4  Insert pending asset&lt;/b&gt;&lt;br&gt;&lt;br&gt;UUID • project • size • role&lt;br&gt;Generated final storage key&lt;br&gt;upload_status = pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1385" y="490" width="350" height="110" />
        </mxCell>
        <mxCell id="2-15" value="&lt;b&gt;5  Send bytes directly&lt;/b&gt;&lt;br&gt;&lt;br&gt;XHR multipart FormData&lt;br&gt;Signed fields + file • upload progress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="630" width="350" height="110" />
        </mxCell>
        <mxCell id="2-16" value="&lt;b&gt;6  Store pending object&lt;/b&gt;&lt;br&gt;&lt;br&gt;Private bucket&lt;br&gt;Transfer success ≠ asset ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="945" y="630" width="350" height="110" />
        </mxCell>
        <mxCell id="2-17" value="&lt;b&gt;7  Request completion&lt;/b&gt;&lt;br&gt;&lt;br&gt;POST /assets/{id}/complete&lt;br&gt;Already ready → idempotent success" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="505" y="800" width="350" height="110" />
        </mxCell>
        <mxCell id="2-18" value="&lt;b&gt;8  Read and validate pending bytes&lt;/b&gt;&lt;br&gt;&lt;br&gt;Exact declared size&lt;br&gt;GLB 2.0 / embedded resources&lt;br&gt;Image format / pixels / dimensions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="945" y="800" width="350" height="120" />
        </mxCell>
        <mxCell id="2-19" value="&lt;b&gt;Valid?&lt;/b&gt;&lt;br&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;shape=rhombus;rounded=0;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1040" y="965" width="160" height="90" />
        </mxCell>
        <mxCell id="2-20" value="&lt;b&gt;422 • remains pending&lt;/b&gt;&lt;br&gt;&lt;br&gt;Missing / corrupt / mismatched object&lt;br&gt;Correct payload; retry completion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="505" y="965" width="350" height="100" />
        </mxCell>
        <mxCell id="2-21" value="&lt;b&gt;9  Promote exact original&lt;/b&gt;&lt;br&gt;&lt;br&gt;Conditional copy using source ETag&lt;br&gt;Final key preserves uploaded bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="945" y="1100" width="350" height="100" />
        </mxCell>
        <mxCell id="2-22" value="&lt;b&gt;10  Mark ready + queue&lt;/b&gt;&lt;br&gt;&lt;br&gt;Asset usable for scene references&lt;br&gt;Queue GLB / TEXTURE_* processing&lt;br&gt;Panorama / IMAGE use originals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
