        </mxCell>
        <mxCell id="4-5" value="&lt;b&gt;Author scene or layout&lt;/b&gt;&lt;br&gt;&lt;br&gt;Prepare scale / axis / yaw&lt;br&gt;Materials • lighting • UV1 bake review&lt;br&gt;Reviewed floors • hotspots • exits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
