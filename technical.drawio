  <diagram id="page-4" name="04 • Authoring &amp; publication">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1330" math="0" shadow="0">
      <root>
        <mxCell id="0" />
