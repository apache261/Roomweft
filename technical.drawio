  <diagram id="page-5" name="05 • Viewer runtime">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1610" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="5-1" value="Viewer runtime — decode, prepare, navigate and render" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=30;fontColor=#183153;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="1720" height="48" />
        </mxCell>
        <mxCell id="5-2" value="Builder, preview, public and embed share SceneViewer. Visual optimization does not redefine approved floors or hotspot occlusion." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=15;fontColor=#183153;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="80" width="1720" height="46" />
        </mxCell>
        <mxCell id="5-3" value="&lt;b&gt;Open selected scene&lt;/b&gt;&lt;br&gt;&lt;br&gt;SceneViewer + scoped asset descriptors&lt;br&gt;Hotspots • material maps • instance IDs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="170" width="370" height="115" />
        </mxCell>
        <mxCell id="5-4" value="&lt;b&gt;Quality and asset policy&lt;/b&gt;&lt;br&gt;&lt;br&gt;Auto / Low / Balanced / HQ&lt;br&gt;DPR caps: 1 / 1.5 / 2&lt;br&gt;Aggregate texture + capability envelopes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="570" y="170" width="420" height="115" />
        </mxCell>
        <mxCell id="5-5" value="&lt;b&gt;Verified derivative usable?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ready runtime-v1 • secure hash support&lt;br&gt;SHA-256 • supported parser / GPU caps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1120" y="160" width="570" height="135" />
        </mxCell>
        <mxCell id="5-6" value="&lt;b&gt;PreparedGLTFLoader&lt;/b&gt;&lt;br&gt;&lt;br&gt;Meshopt decoder • local KTX2/Basis&lt;br&gt;Required extension / texture checks&lt;br&gt;Draco rejected; import error feedback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="570" y="375" width="420" height="125" />
        </mxCell>
        <mxCell id="5-7" value="&lt;b&gt;Original fallback&lt;/b&gt;&lt;br&gt;&lt;br&gt;Missing / corrupt / unsupported derivative&lt;br&gt;Expired original URL → refresh SAME scope&lt;br&gt;Proxy failure → exact visual collision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1120" y="375" width="570" height="125" />
        </mxCell>
        <mxCell id="5-8" value="&lt;b&gt;Prepare cloned GLB or layout&lt;/b&gt;&lt;br&gt;&lt;br&gt;Transforms • material clones • animation mixers&lt;br&gt;Exact proxy optional; authored floor approvals&lt;br&gt;Reviewed UV1 bakes or existing lighting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="570" y="575" width="420" height="145" />
        </mxCell>
        <mxCell id="5-9" value="&lt;b&gt;PANORAMA branch&lt;/b&gt;&lt;br&gt;&lt;br&gt;sRGB inward sphere • basic material&lt;br&gt;Yaw / pitch • drag / pinch / FOV&lt;br&gt;Angular markers; no free movement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0ecea;strokeColor=#479c96;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="375" width="370" height="150" />
        </mxCell>
        <mxCell id="5-10" value="&lt;b&gt;Authored navigation world&lt;/b&gt;&lt;br&gt;&lt;br&gt;Exact collision + approved floor indexes&lt;br&gt;Validate start / arrival / clearance&lt;br&gt;Unready rooms block capsule support&lt;br&gt;120 Hz motion • bounded sweeps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="835" width="420" height="175" />
        </mxCell>
        <mxCell id="5-11" value="&lt;b&gt;Separate visual tree&lt;/b&gt;&lt;br&gt;&lt;br&gt;Compatible static instancing / merge&lt;br&gt;Conservative runtime LOD&lt;br&gt;Room-owned visibility / streaming&lt;br&gt;Authored occlusion remains authoritative" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
