        </mxCell>
        <mxCell id="5-12" value="&lt;b&gt;Lighting and effects&lt;/b&gt;&lt;br&gt;&lt;br&gt;PBR + PMREM reflections&lt;br&gt;Bakes replace indirect diffuse only&lt;br&gt;Opt-in bounded HQ moving shadows&lt;br&gt;No screen-space AO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
