        </mxCell>
        <mxCell id="5-13" value="&lt;b&gt;ViewerRuntime frame scheduling&lt;/b&gt;&lt;br&gt;&lt;br&gt;Visible: demand • hidden: never&lt;br&gt;Input / damping / motion / clips request frames&lt;br&gt;Idle resumes without integrating stale movement&lt;br&gt;Auto trials change DPR before committing assets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0ecea;strokeColor=#479c96;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
