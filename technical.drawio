        </mxCell>
        <mxCell id="1-7" value="&lt;b&gt;React authoring and visitor UI&lt;/b&gt;&lt;br&gt;&lt;br&gt;React 19 • TypeScript • React Router&lt;br&gt;/ • /projects/:id • /t/:slug • /embed/:slug" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="215" width="330" height="150" />
        </mxCell>
        <mxCell id="1-8" value="&lt;b&gt;Shared SceneViewer runtime&lt;/b&gt;&lt;br&gt;&lt;br&gt;Three.js • React Three Fiber 9.8.1 • Drei&lt;br&gt;GLB / generated layouts / panoramas&lt;br&gt;Walking • hotspots • quality • lighting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0ecea;strokeColor=#479c96;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="620" width="330" height="190" />
        </mxCell>
        <mxCell id="1-9" value="&lt;b&gt;Vite frontend service&lt;/b&gt;&lt;br&gt;&lt;br&gt;Port 5173 (default)&lt;br&gt;/api and /health → API proxy&lt;br&gt;Lazy-loaded viewer bundle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="475" y="210" width="260" height="135" />
        </mxCell>
        <mxCell id="1-10" value="&lt;b&gt;Go HTTP API&lt;/b&gt;&lt;br&gt;&lt;br&gt;Go 1.26 • net/http&lt;br&gt;JSON validation • same-project references&lt;br&gt;pgx pool • sqlc + transaction helpers&lt;br&gt;Storage signing • public tour scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="820" y="215" width="420" height="175" />
        </mxCell>
        <mxCell id="1-11" value="&lt;b&gt;PostgreSQL 17&lt;/b&gt;&lt;br&gt;&lt;br&gt;Projects • assets • scenes • hotspots&lt;br&gt;Layout / texture / portal references&lt;br&gt;Derivative jobs and manifests&lt;br&gt;Ordered migrations + advisory lock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;shape=cylinder;boundedLbl=1;backgroundOutline=1;size=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="215" width="350" height="185" />
        </mxCell>
        <mxCell id="1-12" value="&lt;b&gt;Private MinIO / S3 bucket&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pending uploads • preserved originals&lt;br&gt;Low / Balanced / HQ derivatives&lt;br&gt;Exact collision proxy&lt;br&gt;Signed POST / GET: 15-minute expiry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;shape=cylinder;boundedLbl=1;backgroundOutline=1;size=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="620" width="350" height="185" />
        </mxCell>
        <mxCell id="1-13" value="&lt;b&gt;Background worker inside API&lt;/b&gt;&lt;br&gt;&lt;br&gt;Go goroutine; optional script configuration&lt;br&gt;Durable DB claims • attempt UUID • leases&lt;br&gt;Download source → run Node → publish outputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
