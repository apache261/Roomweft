        <mxCell id="2-1" value="Upload lifecycle — selection to usable original" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=30;fontColor=#183153;fontStyle=1;spacing=0;" vertex="1" parent="1">
