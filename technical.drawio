        <mxCell id="3-1" value="Runtime asset processing — durable queue and verified publication" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=30;fontColor=#183153;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="1720" height="48" />
        </mxCell>
        <mxCell id="3-2" value="Worker runs inside the API process. Derivative failure preserves the ready original; no separate message broker is used." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=15;fontColor=#183153;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="80" width="1720" height="46" />
        </mxCell>
        <mxCell id="3-3" value="&lt;b&gt;QUEUED job&lt;/b&gt;&lt;br&gt;&lt;br&gt;asset_id + runtime-v1&lt;br&gt;Completed GLB or TEXTURE_*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="170" width="310" height="110" />
        </mxCell>
        <mxCell id="3-4" value="&lt;b&gt;Atomic claim → PROCESSING&lt;/b&gt;&lt;br&gt;&lt;br&gt;FOR UPDATE SKIP LOCKED&lt;br&gt;Attempt UUID • lease: 15 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="470" y="170" width="350" height="110" />
        </mxCell>
        <mxCell id="3-5" value="&lt;b&gt;Download completed original&lt;/b&gt;&lt;br&gt;&lt;br&gt;Temporary directory • exact size&lt;br&gt;Worker source limit: 256 MiB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="920" y="170" width="350" height="110" />
        </mxCell>
        <mxCell id="3-6" value="&lt;b&gt;Run Node subprocess&lt;/b&gt;&lt;br&gt;&lt;br&gt;10 min task timeout&lt;br&gt;1 GiB Node heap setting&lt;br&gt;Bounded logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1380" y="170" width="350" height="110" />
        </mxCell>
        <mxCell id="3-7" value="&lt;b&gt;Asset type?&lt;/b&gt;&lt;br&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;shape=rhombus;rounded=0;spacing=5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1455" y="345" width="190" height="110" />
        </mxCell>
        <mxCell id="3-8" value="&lt;b&gt;GLB processor&lt;/b&gt;&lt;br&gt;&lt;br&gt;glTF Validator + glTF Transform&lt;br&gt;Validate extensions and triangle input&lt;br&gt;Inventory source paths / geometry / semantics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="830" y="525" width="410" height="130" />
        </mxCell>
        <mxCell id="3-9" value="&lt;b&gt;Texture processor&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sharp decodes PNG / JPEG / WebP&lt;br&gt;Resize without upscaling&lt;br&gt;Check dimensions and alpha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1320" y="525" width="410" height="130" />
        </mxCell>
        <mxCell id="3-10" value="&lt;b&gt;Create 3 verified visual GLBs&lt;/b&gt;&lt;br&gt;&lt;br&gt;Low 1024 • Balanced 2048 • HQ 4096&lt;br&gt;Meshopt encode • PNG image tiers&lt;br&gt;Decode and compare exact semantics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="830" y="730" width="410" height="130" />
        </mxCell>
        <mxCell id="3-11" value="&lt;b&gt;Create 3 PNG image tiers&lt;/b&gt;&lt;br&gt;&lt;br&gt;Low 1024 • Balanced 2048 • HQ 4096&lt;br&gt;SHA-256 + bytes + texture estimates&lt;br&gt;No lighting bake generation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1320" y="730" width="410" height="130" />
        </mxCell>
        <mxCell id="3-12" value="&lt;b&gt;Create exact collision.glb&lt;/b&gt;&lt;br&gt;&lt;br&gt;Strip render-only data&lt;br&gt;Keep hierarchy and exact geometry&lt;br&gt;Floors remain authored-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#183153;fontFamily=Helvetica;fontSize=14;spacing=12;arcSize=10;" vertex="1" parent="1">
